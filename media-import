def _dji_air_volume_detect(vol: Path) -> bool:
    """True if `vol` looks like a DJI drone SD card.

    Accepts either DCIM/<NNN>MEDIA/ with at least one DJI_NNNN.{JPG,MP4},
    or a flight-log artifact at MISC/GIS/dji.gis (cards offloaded after
    deletion may still carry the log).
    """
    if not vol.is_dir():
        return False
    dcim = vol / "DCIM"
    if dcim.is_dir():
        try:
            for sub in dcim.iterdir():
                if not _DJI_AIR_DCIM_DIR_RE.match(sub.name):
                    continue
                try:
                    for f in sub.iterdir():
                        if f.is_file() and _DJI_AIR_FILE_RE.match(f.name):
                            return True
                except (OSError, PermissionError):
                    continue
        except (OSError, PermissionError):
            pass
    if (vol / Path(*_DJI_AIR_GIS_REL)).is_file():
        return True
    return False


def dji_air_discover(volumes: list[Path]) -> list[MediaGroup]:
    """Scan DJI drone volumes; return one MediaGroup per logical capture
    plus one "flightlog" group per card.

    Photo groups: a single DJI_NNNN.JPG today (ARW would coalesce by basename
    if/when we ever shoot RAW). Video groups: DJI_NNNN.MP4 + matching .THM
    + .SCR sidecars from MISC/THM/<NNN>/.

    Body serial: from EXIF on JPGs (drone serial is constant per body).
    MP4-only volumes inherit the per-volume serial scraped from any JPG;
    if no JPG exists, body_serial is "UNKNOWN".
    """
    photos_by_key: dict[tuple[Path, Path, str], list[Path]] = {}
    videos_by_key: dict[tuple[Path, str, str], list[Path]] = {}
    flightlogs: list[tuple[Path, Path]] = []

    for vol in volumes:
        dcim = vol / "DCIM"
        if dcim.is_dir():
            try:
                dcim_subs = list(dcim.iterdir())
            except (OSError, PermissionError):
                dcim_subs = []
            for sub in dcim_subs:
                m = _DJI_AIR_DCIM_DIR_RE.match(sub.name)
                if not m:
                    continue
                num = m.group(1)
                try:
                    files = list(sub.iterdir())
                except (OSError, PermissionError):
                    continue
                for f in files:
                    if not f.is_file():
                        continue
                    fm = _DJI_AIR_FILE_RE.match(f.name)
                    if not fm:
                        continue
                    base, ext = fm.group(1), fm.group(2).upper()
                    if ext == "JPG":
                        photos_by_key.setdefault((vol, sub, base), []).append(f)
                    elif ext == "MP4":
                        videos_by_key.setdefault((vol, num, base), []).append(f)
                # Sidecars share the DCIM folder number under MISC/THM/<num>/.
                thm_dir = vol / "MISC" / "THM" / num
                if thm_dir.is_dir():
                    try:
                        for f in thm_dir.iterdir():
                            if not f.is_file():
                                continue
                            sm = _DJI_AIR_SIDECAR_RE.match(f.name)
                            if not sm:
                                continue
                            base = sm.group(1)
                            videos_by_key.setdefault(
                                (vol, num, base), []
                            ).append(f)
                    except (OSError, PermissionError):
                        pass

        gis = vol / Path(*_DJI_AIR_GIS_REL)
        if gis.is_file():
            flightlogs.append((vol, gis))

    primary_for_photo: dict[tuple[Path, Path, str], Path] = {}
    for key, files in photos_by_key.items():
        primary_for_photo[key] = files[0]   # only one JPG per basename today

    primary_for_video: dict[tuple[Path, str, str], Path] = {}
    for key, files in videos_by_key.items():
        mp4 = next((f for f in files if f.suffix.upper() == ".MP4"), None)
        if mp4 is not None:
            primary_for_video[key] = mp4

    primaries = list(primary_for_photo.values()) + list(primary_for_video.values())
    meta = exiftool_batch(
        primaries,
        tags=["DateTimeOriginal", "CreateDate", "SerialNumber"],
    )

    # Per-volume serial fallback: the drone body serial is constant, so
    # any JPG's SerialNumber answers for MP4s and the flight log too.
    vol_serial: dict[Path, str] = {}
    for key, primary in primary_for_photo.items():
        vol = key[0]
        if vol in vol_serial:
            continue
        rec = meta.get(primary, {})
        ser = rec.get("SerialNumber")
        if ser:
            vol_serial[vol] = str(ser)

    groups: list[MediaGroup] = []

    for key, files in photos_by_key.items():
        vol = key[0]
        primary = primary_for_photo[key]
        rec = meta.get(primary, {})
        ts = _sony_parse_dt(rec.get("DateTimeOriginal"))
        if ts is None:
            continue
        try:
            size = sum(f.stat().st_size for f in files)
        except OSError:
            continue
        body_serial = str(
            rec.get("SerialNumber") or vol_serial.get(vol) or "UNKNOWN"
        )
        groups.append(MediaGroup(
            kind="photo",
            primary=primary,
            files=sorted(files),
            timestamp=ts,
            body_serial=body_serial,
            size_bytes=size,
            volume=vol,
        ))

    for key, files in videos_by_key.items():
        if key not in primary_for_video:
            continue
        vol = key[0]
        primary = primary_for_video[key]
        rec = meta.get(primary, {})
        # MP4 only carries QuickTime CreateDate (in UTC for Mavic Air 2).
        # Users near a UTC day boundary may see clips bucketed off-by-one;
        # documented as a known quirk.
        ts = _sony_parse_dt(rec.get("CreateDate") or rec.get("DateTimeOriginal"))
        if ts is None:
            continue
        try:
            size = sum(f.stat().st_size for f in files)
        except OSError:
            continue
        body_serial = str(
            rec.get("SerialNumber") or vol_serial.get(vol) or "UNKNOWN"
        )
        groups.append(MediaGroup(
            kind="video",
            primary=primary,
            files=sorted(files),
            timestamp=ts,
            body_serial=body_serial,
            size_bytes=size,
            volume=vol,
        ))

    for vol, p in flightlogs:
        try:
            stat = p.stat()
        except OSError:
            continue
        # Date-bucket by file mtime — the .gis log is per-card-session and
        # not tied to a single capture, so EXIF-style timestamps don't apply.
        groups.append(MediaGroup(
            kind="flightlog",
            primary=p,
            files=[p],
            timestamp=datetime.fromtimestamp(stat.st_mtime),
            body_serial=vol_serial.get(vol, "UNKNOWN"),
            size_bytes=stat.st_size,
            volume=vol,
        ))

    return groups


def dji_air_filter_by_args(groups: list[MediaGroup],
                             args: argparse.Namespace) -> list[MediaGroup]:
    out = groups
    if args.from_date:
        out = [g for g in out if g.timestamp.date() >= args.from_date]
    if args.to_date:
        out = [g for g in out if g.timestamp.date() <= args.to_date]
    if args.days is not None and args.days > 0:
        cutoff = (datetime.now() - timedelta(days=args.days)).date()
        out = [g for g in out if g.timestamp.date() >= cutoff]
    return out


def _dji_air_dest_dir_for(dest_root: Path, bucket: date, kind: str) -> Path:
    """Output dir for drone media.

    Photos/videos: <dest>/RAW/<date>/DJI-DRONES/{PHOTOS,VIDEOS}/
    Flight log:    <dest>/FLIGHTLOGS/<date>/    (sibling to RAW/, per-card-
                                                 session artifact, not per
                                                 capture)

    Body-serial level was removed for the same reason as Sony: MP4s carry
    no serial tag, the fallback created `UNKNOWN/` folders, and one drone
    per setup is assumed. The MediaGroup.body_serial field is still
    populated for verify/diagnostic display; it just isn't in the path.
    """
    if kind == "flightlog":
        return dest_root / FLIGHTLOGS_DIR_NAME / bucket.isoformat()
    category = "PHOTOS" if kind == "photo" else "VIDEOS"
    return (dest_root / RAW_ROOT / bucket.isoformat()
            / DJI_AIR_DEVICE_CLASS / category)


def dji_air_build_plan(groups: list[MediaGroup],
                         args: argparse.Namespace) -> Plan:
    """Build a Plan from drone groups. Stage → finalize pattern. Idempotent.

    Same overwrite policy as Sony: same-size dst → skip, different-size dst
    → flag overwrite_existing for surfacing in preview.
    """
    plan = Plan(dest=args.dest)
    staging = args.dest / STAGING_DIR_NAME

    for g in groups:
        target_dir = _dji_air_dest_dir_for(args.dest, g.timestamp.date(),
                                             g.kind)
        for src in g.files:
            try:
                src_size = src.stat().st_size
            except OSError:
                continue
            final = target_dir / src.name
            classification = classify_dst(final, src_size)
            if classification is None:
                continue
            overwrite, existing_size = classification
            staged = staging / src.name
            plan.copies.append(CopyOp(src=src, dst=staged, size_bytes=src_size))
            plan.singleton_moves.append(CopyOp(
                src=staged, dst=final, size_bytes=src_size,
                overwrite_existing=overwrite,
                existing_size_bytes=existing_size,
            ))

    plan.args_summary = {
        "dest": str(args.dest),
        "from": args.from_date.isoformat() if args.from_date else None,
        "to": args.to_date.isoformat() if args.to_date else None,
        "device": "dji-air-2",
    }
    return plan


def dji_air_completion_dates(volumes: list[Path]) -> list[date]:
    """All distinct shoot dates across drone volumes.

    Lighter-weight than Sony's signature-cached completion (drone cards are
    typically <100 captures); we just run discover and dedupe. If perf
    becomes an issue, add a `_sony_volume_signature`-style cache.
    """
    dates: set[date] = set()
    if volumes:
        groups = dji_air_discover(volumes)
        dates.update(g.timestamp.date() for g in groups)
    return sorted(dates)


DJI_AIR_2 = Device(
    name="dji-air-2",
    device_class=DJI_AIR_DEVICE_CLASS,
    supports_transcribe=False,   # drone audio is wind/motor — never useful
    detect=_dji_air_volume_detect,
    discover=dji_air_discover,
    filter_by_args=dji_air_filter_by_args,
    build_plan=dji_air_build_plan,
    completion_dates=dji_air_completion_dates,
)


# Ordered registry consulted by select_devices. New devices append here.
# Order is the auto-detect priority — earlier devices win ties (none today).
ALL_DEVICES: list[Device] = [DJI_MIC, SONY_A7C, DJI_AIR_2]


def _sony_is_verified() -> bool:
    """True if the one-time Sony real-card verification has been completed."""
    return SONY_VERIFICATION_PATH.exists()


def _check_sony_verification() -> None:
    if not SONY_VERIFICATION_PATH.exists():
        sys.exit(
            "media-import: Sony A7C import is gated behind a one-time real-card\n"
            "verification step.\n"
            "  1. Insert your Sony A7C SD card.\n"
            "  2. Run: media-import --verify-sony\n"
            "  3. Confirm the scan output looks correct.\n"
            "After that, normal `--device sony` invocations will work."
        )


def cmd_verify_sony() -> int:
    require_exiftool()
    all_volumes = find_all_volumes()
    sony_vols = [v for v in all_volumes if SONY_A7C.detect(v)]
    if not sony_vols:
        print("media-import: no Sony A7C card detected on /Volumes/.",
              file=sys.stderr)
        return 1
    print("Detected Sony A7C card(s):", file=sys.stderr)
    for v in sony_vols:
        print(f"  {v}", file=sys.stderr)
    groups = sony_discover(sony_vols)
    if not groups:
        print("media-import: scan returned 0 groups. Aborting verification.",
              file=sys.stderr)
        return 1
    photo_count = sum(1 for g in groups if g.kind == "photo")
    video_count = sum(1 for g in groups if g.kind == "video")
    print(f"\nFound {len(groups)} groups: "
          f"{photo_count} photo, {video_count} video.", file=sys.stderr)
    print("\nSample groups (first 5):", file=sys.stderr)
    for g in groups[:5]:
        print(f"  [{g.kind}] {g.timestamp.isoformat()} body={g.body_serial}",
              file=sys.stderr)
        for f in g.files:
            try:
                rel = f.relative_to(g.volume)
            except ValueError:
                rel = f
            try:
                size = f.stat().st_size
            except OSError:
                size = 0
            print(f"    {rel} ({size} bytes)", file=sys.stderr)
    serials = sorted({g.body_serial for g in groups})
    dates = sorted({g.timestamp.date() for g in groups})
    print(f"\nBody serial(s) seen: {serials}", file=sys.stderr)
    if dates:
        print(f"Date range: {dates[0]} to {dates[-1]}", file=sys.stderr)
    confirm = input("\nDoes this look correct? [y/N] ").strip().lower()
    if confirm != "y":
        print("Verification not recorded.", file=sys.stderr)
        return 1
    SONY_VERIFICATION_PATH.parent.mkdir(parents=True, exist_ok=True)
    record = {
        "verified_at": datetime.now().isoformat(),
        "body_serials": serials,
        "sample_groups": [
            {"kind": g.kind,
             "timestamp": g.timestamp.isoformat(),
             "body_serial": g.body_serial,
             "files": [str(f.relative_to(g.volume))
                       if g.volume in f.parents or f == g.volume
                       else str(f)
                       for f in g.files]}
            for g in groups[:10]
        ],
    }
    with open(SONY_VERIFICATION_PATH, "w") as f:
        json.dump(record, f, indent=2)
    print(f"\nVerification recorded at {SONY_VERIFICATION_PATH}.",
          file=sys.stderr)
    print("Sony imports are now unlocked.", file=sys.stderr)
    return 0


def select_devices(volumes: list[Path], requested: str) -> list[Device]:
    """All devices to import this run, in ALL_DEVICES order.

    Explicit --device → exactly that one device. 'auto' → every device with
    at least one matching volume. Exits (same messages as before) on an
    unknown name or when auto-detect finds nothing.

    `requested` is canonical (model-specific). Aliases are handled at parse
    time by `_parse_device`.
    """
    if requested != "auto":
        for d in ALL_DEVICES:
            if requested == d.name:
                return [d]
        valid = ", ".join(d.name for d in ALL_DEVICES)
        sys.exit(f"media-import: unknown device {requested!r}; "
                 f"valid: auto, {valid}")
    found = [d for d in ALL_DEVICES if any(d.detect(v) for v in volumes)]
    if not found:
        valid = ", ".join(d.name for d in ALL_DEVICES)
        sys.exit(f"media-import: no recognized media device on any mounted volume. "
                 f"Pass --device <{valid}> explicitly.")
    assert found  # invariant: select_devices never returns an empty list
    return found


def select_device(volumes: list[Path], requested: str) -> Device:
    """First of select_devices; for callers that need a single device. Exits (via select_devices) on no match."""
    return select_devices(volumes, requested)[0]


