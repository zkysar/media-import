# ─────────────────────────── dataclasses ────────────────────────────


@dataclass
class Wav:
    fmt_code: int
    channels: int
    sample_rate: int
    block_align: int
    bits_per_sample: int
    data_offset: int
    data_size: int

    @property
    def nframes(self) -> int:
        return self.data_size // self.block_align if self.block_align else 0

    @property
    def duration_s(self) -> float:
        return self.nframes / self.sample_rate if self.sample_rate else 0.0


@dataclass
class Clip:
    path: Path
    tx: str             # "TX01" / "TX02"
    clip_idx: int
    start: datetime     # from filename
    version: str        # "edit" / "orig"
    wav: Wav
    volume: Path        # mount point

    @property
    def end(self) -> datetime:
        return self.start + timedelta(seconds=self.wav.duration_s)

    @property
    def size_bytes(self) -> int:
        try:
            return self.path.stat().st_size
        except OSError:
            return 0


@dataclass
class Chain:
    """Two-or-more clips that DJI auto-split. Length-1 lists are singletons."""
    clips: list[Clip]   # in start-time order
    tx: str
    version: str

    @property
    def is_singleton(self) -> bool:
        return len(self.clips) < 2

    @property
    def start(self) -> datetime:
        return self.clips[0].start

    @property
    def end(self) -> datetime:
        return self.clips[-1].end

    @property
    def date_bucket(self) -> date:
        return self.start.date()


@dataclass
class CopyOp:
    src: Path
    dst: Path
    size_bytes: int
    # True when dst already exists with a *different* size and we intend to
    # replace it. Same-size existing dsts are skipped before reaching here.
    # Surfaced in the preview so the user knows what's about to be clobbered.
    overwrite_existing: bool = False
    # Pre-existing dst size, captured at plan time for preview display.
    # Only meaningful when overwrite_existing is True.
    existing_size_bytes: int = 0


@dataclass
class JoinOp:
    chain: Chain
    staged_inputs: list[Path]   # paths in staging
    output: Path                # final dest path
    expected_frames: int        # sum(in_frames) − sum(overlap_frames); set at run time


@dataclass
class TranscribeOp:
    audio: Path
    output_dir: Path
    duration_s: float


@dataclass
class AudioExtractOp:
    src: Path                 # the final video path (e.g. RAW/.../VIDEOS/C0001.MP4)
    dst: Path                 # the WAV target (e.g. RAW/.../TRANSCRIPTS/C0001.wav)


@dataclass
class Plan:
    copies: list[CopyOp] = field(default_factory=list)
    joins: list[JoinOp] = field(default_factory=list)
    transcribes: list[TranscribeOp] = field(default_factory=list)
    singleton_moves: list[CopyOp] = field(default_factory=list)  # staged → final
    audio_extracts: list[AudioExtractOp] = field(default_factory=list)
    dest: Path = Path()
    args_summary: dict = field(default_factory=dict)

    @property
    def overwrites(self) -> list[CopyOp]:
        """Singleton moves that will replace an existing file with one of a
        different size. Shown in the preview so the user can see what's
        about to be clobbered before confirming."""
        return [op for op in self.singleton_moves if op.overwrite_existing]


@dataclass
class MediaGroup:
    """One logical capture as discovered on a card.

    Used by every device whose imports are per-clip-with-sidecars (Sony A7C,
    DJI Mavic Air 2, …). DJI Mic stays on Clip/Chain because its chain
    detection is mic-specific.

    `kind` values currently in use:
      "photo"     — still image group (primary JPG/ARW, possibly siblings)
      "video"     — moving image group (primary MP4 + .THM/.SCR/.XML sidecars)
      "flightlog" — per-card artifact not tied to a single capture
                    (e.g. DJI's MISC/GIS/dji.gis). Routed off the
                    RAW/<date>/DEVICE-CLASS/ tree by build_plan.
    """
    kind: str
    primary: Path           # main file (JPG for photos, MP4 for video, .gis for flightlog)
    files: list[Path]       # all files in the group (primary + sidecars)
    timestamp: datetime     # from exiftool / file mtime
    body_serial: str        # from exiftool SerialNumber, "UNKNOWN" if absent
    size_bytes: int         # sum of all file sizes in the group
    volume: Path            # the source SD-card volume root


# Backwards-compat alias — older callers / tests may still import SonyGroup.
SonyGroup = MediaGroup


