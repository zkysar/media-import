def _dji_completion_dates(volumes: list[Path]) -> list[date]:
    """All distinct recording dates found across DJI volumes (parsed from filenames)."""
    dates: set[date] = set()
    for vol in volumes:
        for p in vol.rglob("*.wav"):
            mo = DJI_FILE_RE.search(p.name)
            if mo:
                try:
                    dates.add(datetime.strptime(mo.group(3), "%Y%m%d").date())
                except ValueError:
                    pass
    return sorted(dates)


