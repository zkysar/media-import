def _sony_volume_detect(vol: Path) -> bool:
    """True if `vol` looks like a Sony A7C SD card."""
    if not vol.is_dir():
        return False
    dcim = vol / "DCIM"
    if dcim.is_dir():
        try:
            for sub in dcim.iterdir():
                if SONY_STILLS_DIR_RE.match(sub.name):
                    return True
        except (OSError, PermissionError):
            pass
    for vid_root in SONY_VIDEO_ROOTS:
        if (vol / vid_root).is_dir():
            return True
    return False


def _sony_is_db_path(p: Path, vol: Path) -> bool:
    """True if `p` is a Sony database/firmware artifact that must NOT be copied."""
    rel = str(p.relative_to(vol))
    if rel.startswith("PRIVATE/SONY/"):
        return True
    for db in SONY_VIDEO_DB_PATHS:
        if rel == db or rel.startswith(db + "/"):
            return True
    if p.suffix.lower() == ".dat" or p.name == "INDEX.BDM":
        return True
    return False


_SONY_VIDEO_BASENAME_RE = re.compile(r"^(C\d{4})(?:[MR]\d{2})?$")


def _sony_video_basename(name_no_ext: str) -> str:
    """Strip M01/R01 suffixes so C0001M01 and C0001 group together."""
    mo = _SONY_VIDEO_BASENAME_RE.match(name_no_ext)
    return mo.group(1) if mo else name_no_ext


def _sony_parse_dt(s: str | None) -> datetime | None:
    """Parse 'YYYY:MM:DD HH:MM:SS' (exiftool's default with -d format flag)."""
    if not s:
        return None
    try:
        return datetime.strptime(s, "%Y:%m:%d %H:%M:%S")
    except ValueError:
        return None


def _sony_serial_from_rec(rec: dict) -> str | None:
    """Body serial out of an exiftool record. Tag varies by file type:
    Sony JPEGs expose SerialNumber, ARW raws expose InternalSerialNumber,
    MP4s usually expose nothing. Returns None if no tag found.
    """
    for tag in ("SerialNumber", "InternalSerialNumber", "BodySerialNumber"):
        v = rec.get(tag)
        if v:
            return str(v)
    return None


def sony_discover(volumes: list[Path]) -> list[MediaGroup]:
    """Scan Sony A7C SD-card volumes; return SonyGroups (one per logical capture).

    Photo groups: same-basename .JPG / .ARW within a DCIM/<NNN>MSDCF/ folder
    coalesce into one group. The .JPG (when present) is treated as primary.

    Video groups: .MP4 + matching .XML (basename match after stripping
    M01/R01 suffix) coalesce. The .MP4 is primary. Thumbnails under
    PRIVATE/M4ROOT/THMBNL/ (e.g. CnnnnT01.JPG on A7C firmware) are
    intentionally skipped — not imported.

    DB / firmware artifacts (MEDIAPRO.XML, STATUS.BIN, AVF_INFO/, PRIVATE/SONY/,
    .dat files, INDEX.BDM) are skipped — not in any group, never read.

    Groups whose primary's EXIF can't be parsed (no DateTimeOriginal /
    CreateDate) are dropped — caller can't filter or place them.

    Body serial falls back across SerialNumber → InternalSerialNumber →
    BodySerialNumber → any still's serial on the same volume → "UNKNOWN".
    MP4s lack serial tags on A7C, so the per-volume fallback is how videos
    get a non-UNKNOWN serial.
    """
    stills_by_base: dict[tuple[Path, Path, str], list[Path]] = {}
    videos_by_basename: dict[tuple[Path, str], list[Path]] = {}

    for vol in volumes:
        dcim = vol / "DCIM"
        if dcim.is_dir():
            for sub in dcim.iterdir():
                if not SONY_STILLS_DIR_RE.match(sub.name):
                    continue
                try:
                    iter_files = list(sub.iterdir())
                except (OSError, PermissionError):
                    continue
                for f in iter_files:
                    if not f.is_file():
                        continue
                    if f.suffix.upper() not in SONY_STILL_EXTS:
                        continue
                    key = (vol, sub, f.stem)
                    stills_by_base.setdefault(key, []).append(f)

        for vid_root in SONY_VIDEO_ROOTS:
            d = vol / vid_root / "CLIP"
            if not d.is_dir():
                continue
            try:
                iter_files = list(d.iterdir())
            except (OSError, PermissionError):
                continue
            for f in iter_files:
                if not f.is_file():
                    continue
                if _sony_is_db_path(f, vol):
                    continue
                base = _sony_video_basename(f.stem)
                videos_by_basename.setdefault((vol, base), []).append(f)

    primary_for_still: dict[tuple[Path, Path, str], Path] = {}
    for key, files in stills_by_base.items():
        jpg = next((f for f in files if f.suffix.upper() == ".JPG"), None)
        primary_for_still[key] = jpg or files[0]

    primary_for_video: dict[tuple[Path, str], Path] = {}
    for key, files in videos_by_basename.items():
        mp4 = next((f for f in files if f.suffix.upper() == ".MP4"), None)
        if mp4 is not None:
            primary_for_video[key] = mp4

    primaries = list(primary_for_still.values()) + list(primary_for_video.values())
    meta = exiftool_batch(
        primaries,
        tags=["DateTimeOriginal", "CreateDate",
              "SerialNumber", "InternalSerialNumber", "BodySerialNumber"],
    )

    # Per-volume serial fallback: MP4s on A7C carry no serial tag, so any
    # still's serial on the same card answers for the videos too.
    vol_serial: dict[Path, str] = {}
    for key, primary in primary_for_still.items():
        vol = key[0]
        if vol in vol_serial:
            continue
        ser = _sony_serial_from_rec(meta.get(primary, {}))
        if ser:
            vol_serial[vol] = ser

    groups: list[MediaGroup] = []

    for key, files in stills_by_base.items():
        vol = key[0]
        primary = primary_for_still[key]
        rec = meta.get(primary, {})
        ts = _sony_parse_dt(rec.get("DateTimeOriginal"))
        if ts is None:
            continue
        try:
            size = sum(f.stat().st_size for f in files)
        except OSError:
            continue
        groups.append(MediaGroup(
            kind="photo",
            primary=primary,
            files=sorted(files),
            timestamp=ts,
            body_serial=(_sony_serial_from_rec(rec)
                        or vol_serial.get(vol)
                        or "UNKNOWN"),
            size_bytes=size,
            volume=vol,
        ))

    for key, files in videos_by_basename.items():
        if key not in primary_for_video:
            continue
        vol = key[0]
        primary = primary_for_video[key]
        rec = meta.get(primary, {})
        ts = _sony_parse_dt(rec.get("CreateDate") or rec.get("DateTimeOriginal"))
        if ts is None:
            continue
        try:
            size = sum(f.stat().st_size for f in files)
        except OSError:
            continue
        groups.append(MediaGroup(
            kind="video",
            primary=primary,
            files=sorted(files),
            timestamp=ts,
            body_serial=(_sony_serial_from_rec(rec)
                        or vol_serial.get(vol)
                        or "UNKNOWN"),
            size_bytes=size,
            volume=vol,
        ))

    return groups


def sony_filter_by_args(groups: list[MediaGroup],
                         args: argparse.Namespace) -> list[MediaGroup]:
    out = groups
    if args.from_date:
        out = [g for g in out if g.timestamp.date() >= args.from_date]
    if args.to_date:
        out = [g for g in out if g.timestamp.date() <= args.to_date]
    if args.days is not None and args.days > 0:
        cutoff = (datetime.now() - timedelta(days=args.days)).date()
        out = [g for g in out if g.timestamp.date() >= cutoff]
    return out


def sony_build_plan(groups: list[MediaGroup],
                     args: argparse.Namespace) -> Plan:
    """Build a Plan from Sony groups. Stage → finalize pattern. Idempotent."""
    plan = Plan(dest=args.dest)
    staging = args.dest / STAGING_DIR_NAME

    for g in groups:
        target_dir = sony_dest_dir_for(args.dest, g.timestamp.date(), g.kind)
        for src in g.files:
            try:
                src_size = src.stat().st_size
            except OSError:
                continue
            final = target_dir / src.name
            classification = classify_dst(final, src_size)
            if classification is None:
                continue   # dst already present at correct size
            overwrite, existing_size = classification
            staged = staging / src.name
            plan.copies.append(CopyOp(src=src, dst=staged, size_bytes=src_size))
            plan.singleton_moves.append(CopyOp(
                src=staged, dst=final, size_bytes=src_size,
                overwrite_existing=overwrite,
                existing_size_bytes=existing_size,
            ))

        if g.kind == "video" and args.transcribe:
            transcripts_dir = (args.dest / RAW_ROOT
                                / g.timestamp.date().isoformat()
                                / SONY_DEVICE_CLASS
                                / TRANSCRIPTS_CATEGORY)
            final_video = target_dir / g.primary.name
            audio_wav = transcripts_dir / (g.primary.stem + ".wav")
            srt_path = transcripts_dir / (g.primary.stem + ".srt")
            if not srt_path.exists():
                plan.audio_extracts.append(AudioExtractOp(
                    src=final_video, dst=audio_wav))
                plan.transcribes.append(TranscribeOp(
                    audio=audio_wav,
                    output_dir=transcripts_dir,
                    duration_s=0.0,
                ))

    plan.args_summary = {
        "dest": str(args.dest),
        "from": args.from_date.isoformat() if args.from_date else None,
        "to": args.to_date.isoformat() if args.to_date else None,
        "device": "sony-a7c",
        "transcribe": args.transcribe,
        "model": getattr(args, "model", None) if args.transcribe else None,
    }
    return plan


def sony_completion_dates(volumes: list[Path]) -> list[date]:
    """All distinct shoot dates across Sony volumes, with on-disk cache.

    Cache is keyed by the volume's directory name and a cheap content
    signature (file count + max mtime under media folders). Stale cache
    entries are silently regenerated.
    """
    dates: set[date] = set()
    for vol in volumes:
        cache_path = SONY_DATE_CACHE_DIR / f"{vol.name}.json"
        sig = _sony_volume_signature(vol)
        cached = _load_sony_date_cache(cache_path)
        if cached and cached.get("sig") == sig:
            for s in cached.get("dates", []):
                try:
                    dates.add(date.fromisoformat(s))
                except (TypeError, ValueError):
                    pass
            continue
        # Cold-cache: scan + write.
        groups = sony_discover([vol])
        scanned = sorted({g.timestamp.date() for g in groups})
        dates.update(scanned)
        _save_sony_date_cache(cache_path, sig,
                                [d.isoformat() for d in scanned])
    return sorted(dates)


def _sony_volume_signature(vol: Path) -> str:
    """Cheap signature: file count + max mtime under DCIM/MSDCF + M4ROOT/CLIP."""
    paths: list[Path] = []
    dcim = vol / "DCIM"
    if dcim.is_dir():
        try:
            for sub in dcim.iterdir():
                if SONY_STILLS_DIR_RE.match(sub.name):
                    try:
                        paths.extend(sub.glob("*"))
                    except (OSError, PermissionError):
                        continue
        except (OSError, PermissionError):
            pass
    for vid_root in SONY_VIDEO_ROOTS:
        clip = vol / vid_root / "CLIP"
        if clip.is_dir():
            try:
                paths.extend(clip.glob("*"))
            except (OSError, PermissionError):
                continue
    if not paths:
        return "empty"
    try:
        max_mtime = max((p.stat().st_mtime for p in paths if p.is_file()),
                          default=0)
    except OSError:
        max_mtime = 0
    return f"{len(paths)}:{int(max_mtime)}"


def _load_sony_date_cache(p: Path) -> dict | None:
    if not p.exists():
        return None
    try:
        with open(p) as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return None


def _save_sony_date_cache(p: Path, sig: str, dates: list[str]) -> None:
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        with open(p, "w") as f:
            json.dump({"sig": sig, "dates": dates}, f)
    except OSError:
        pass


