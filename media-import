def _filter_clips(clips: list[Clip], *,
                  ctx_from: date | None = None,
                  ctx_to: date | None = None,
                  ctx_mic: str | None = None,
                  ctx_version: str | None = None) -> list[Clip]:
    out: list[Clip] = []
    for c in clips:
        if ctx_from and c.start.date() < ctx_from:
            continue
        if ctx_to and c.start.date() > ctx_to:
            continue
        if ctx_mic and ctx_mic != "all" and c.tx != ctx_mic:
            continue
        if ctx_version == "edit" and c.version != "edit":
            continue
        if ctx_version == "orig" and c.version != "orig":
            continue
        out.append(c)
    return out


def _summarize(clips: list[Clip]) -> tuple[int, int, str]:
    n = len(clips)
    audio_m = int(sum(c.wav.duration_s for c in clips) / 60)
    tx_str = ",".join(sorted({c.tx for c in clips})) if clips else ""
    return n, audio_m, tx_str


def cmd_complete(kind: str, args: argparse.Namespace) -> int:
    """Hidden subcommand for zsh completion."""

    def _try_date(s: str | None) -> date | None:
        if not s:
            return None
        try:
            return datetime.strptime(s, "%Y-%m-%d").date()
        except ValueError:
            return None

    ctx_from = _try_date(getattr(args, "ctx_from", None))
    ctx_to = _try_date(getattr(args, "ctx_to", None))
    raw_mic = getattr(args, "ctx_mic", None)
    ctx_mic = raw_mic if raw_mic in ("TX01", "TX02", "all") else None
    raw_ver = getattr(args, "ctx_version", None)
    ctx_version = raw_ver if raw_ver in ("edit", "orig", "both") else None

    if kind == "models":
        if WHISPER_CACHE_DIR.exists():
            for p in sorted(WHISPER_CACHE_DIR.glob("*.pt")):
                print(p.stem)
        return 0

    if kind not in ("dates-from", "dates-to", "mics", "versions"):
        return 0

    if kind in ("dates-from", "dates-to"):
        all_volumes = find_all_volumes()
        try:
            device = select_device(all_volumes,
                                   requested=getattr(args, "ctx_device", "auto") or "auto")
        except SystemExit:
            return 0
        # DJI Mic completion needs Clip-shaped data (clip count, audio min,
        # tx labels) which doesn't apply to per-capture group devices.
        # Group-shaped devices (Sony, drone, future) just emit ISO dates.
        if device is not DJI_MIC:
            relevant = [v for v in all_volumes if device.detect(v)]
            for d in device.completion_dates(relevant):
                print(d.isoformat())
            return 0

    vols = find_dji_volumes()
    clips = discover_clips(vols)
    if not clips:
        return 0

    if kind == "dates-from":
        # Don't filter by --from (that's what we're picking). Filter by everything else.
        base = _filter_clips(clips, ctx_to=ctx_to,
                             ctx_mic=ctx_mic, ctx_version=ctx_version)
        if not base:
            return 0
        all_dates = sorted({c.start.date() for c in base})
        upper = ctx_to or max(c.start.date() for c in base)
        for d in all_dates:
            if d > upper:
                continue
            sel = [c for c in base if d <= c.start.date() <= upper]
            if not sel:
                continue
            n, audio_m, tx_str = _summarize(sel)
            print(f"{d.isoformat()}:{n} clips · {audio_m}m · {tx_str}")
        return 0

    if kind == "dates-to":
        base = _filter_clips(clips, ctx_from=ctx_from,
                             ctx_mic=ctx_mic, ctx_version=ctx_version)
        if not base:
            return 0
        all_dates = sorted({c.start.date() for c in base})
        lower = ctx_from or min(c.start.date() for c in base)
        for d in all_dates:
            if d < lower:
                continue
            sel = [c for c in base if lower <= c.start.date() <= d]
            if not sel:
                continue
            n, audio_m, tx_str = _summarize(sel)
            print(f"{d.isoformat()}:{n} clips · {audio_m}m · {tx_str}")
        return 0

    if kind == "mics":
        base = _filter_clips(clips, ctx_from=ctx_from, ctx_to=ctx_to,
                             ctx_version=ctx_version)
        labels = {"TX01": "transmitter 1",
                  "TX02": "transmitter 2",
                  "all":  "both transmitters"}
        for v in ("TX01", "TX02", "all"):
            sel = base if v == "all" else [c for c in base if c.tx == v]
            if not sel:
                continue
            n, audio_m, _ = _summarize(sel)
            print(f"{v}:{n} clips · {audio_m}m · {labels[v]}")
        return 0

    if kind == "versions":
        base = _filter_clips(clips, ctx_from=ctx_from, ctx_to=ctx_to,
                             ctx_mic=ctx_mic)
        for v in ("edit", "orig", "both"):
            sel = base if v == "both" else [c for c in base if c.version == v]
            if not sel:
                continue
            n, audio_m, tx_str = _summarize(sel)
            print(f"{v}:{n} clips · {audio_m}m · {tx_str}")
        return 0

    return 0


# ───────────────────────── argparse / main ─────────────────────────


def parse_iso_date(s: str) -> date:
    return datetime.strptime(s, "%Y-%m-%d").date()


_DEVICE_ALIASES = {
    "dji": "dji-mic-2",      # ambiguous now that DJI Air 2 exists; warn + map
    "sony": "sony-a7c",      # symmetry; explicit beats abbreviated
}


def _parse_device(s: str) -> str:
    """Argparse type for --device. Maps deprecated aliases to canonical names.

    Validation against the actual device registry happens in select_device,
    so a new Device only requires adding it to ALL_DEVICES.
    """
    canonical = _DEVICE_ALIASES.get(s, s)
    if s in _DEVICE_ALIASES:
        sys.stderr.write(
            f"warning: --device {s} is deprecated; use --device {canonical}\n"
        )
    return canonical


_SLUG_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")


def _parse_slug(s: str) -> str:
    if not _SLUG_RE.match(s):
        raise argparse.ArgumentTypeError(
            f"invalid slug {s!r}: must be lowercase alphanumeric with "
            f"single dashes (e.g. 'marple-pics')"
        )
    return s


def _earliest_shoot_date(items: list, chains: list) -> date | None:
    """Earliest capture date across the items the user is about to import.

    Mic uses chain.date_bucket (post-chain-detection); Sony/drone use the
    MediaGroup.timestamp. None if nothing has a usable date.
    """
    candidates: list[date] = []
    if chains:
        candidates.extend(c.date_bucket for c in chains)
    for it in items:
        ts = getattr(it, "timestamp", None)
        if ts is not None:
            candidates.append(ts.date())
    return min(candidates) if candidates else None


def prompt_with_default(prompt: str, default: str) -> str:
    """Bracket-default prompt: shows `[default]`; empty input accepts it.

    Avoids readline pre-fill (unreliable on macOS libedit — fails silently,
    leaving the user staring at an empty prompt with no hint a default
    exists). Non-TTY returns the default unchanged.
    """
    if not sys.stdin.isatty():
        return default
    try:
        raw = input(f"{prompt} [{default}]: ").strip()
    except EOFError:
        return default
    return raw or default


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="media-import",
        description="Import media from DJI Mic 2, Sony A7C, and DJI Mavic Air 2.",
    )
    p.add_argument("--device", type=_parse_device, default="auto",
                   help="which device profile to use; 'auto' detects from card content. "
                        "Valid: auto, dji-mic-2, sony-a7c, dji-air-2 "
                        "(legacy aliases dji, sony still accepted with a warning)")
    p.add_argument("--dest", type=Path,
                   help="Destination directory (required for actual runs). "
                        "With a trailing slug positional, treated as the "
                        "parent root and the proposed dest becomes "
                        "<dest>/<earliest-shoot-date>-<slug>/.")
    p.add_argument("slug", nargs="?", type=_parse_slug,
                   help="Optional slug. When given, the proposed dest is "
                        "<dest>/<earliest-shoot-date>-<slug>/ where the "
                        "date is read from the media's EXIF/filename "
                        "after discovery. You'll be prompted to confirm "
                        "or edit the path before the import runs. Slug "
                        "must be lowercase alnum with single dashes "
                        "(e.g. 'marple-pics').")
    p.add_argument("--from", dest="from_date", type=parse_iso_date,
                   help="Earliest recording date (YYYY-MM-DD)")
    p.add_argument("--to", dest="to_date", type=parse_iso_date,
                   help="Latest recording date (YYYY-MM-DD)")
    p.add_argument("--days", type=int,
                   help="Last N days (mutually exclusive with --from/--to)")
    p.add_argument("--version", choices=("edit", "orig", "both"), default="both")
    p.add_argument("--mic", choices=("TX01", "TX02", "all"), default="all")
    p.add_argument("--join", dest="join", action="store_true", default=True)
    p.add_argument("--no-join", dest="join", action="store_false")
    p.add_argument("--verify-sony", action="store_true",
                   help="run Sony A7C real-card verification (one-time setup)")
    p.add_argument("--transcribe", action="store_true",
                   help="Transcribe joined files via whisper")
    p.add_argument("--model", default="tiny",
                   help="Whisper model (only used with --transcribe)")
    p.add_argument("--yes", action="store_true",
                   help="Skip confirmation prompt")
    p.add_argument("--dry-run", action="store_true",
                   help="Show preview only; never execute")
    p.add_argument("--eject", action="store_true",
                   help="Try to eject source volumes after a successful import (best-effort)")
    p.add_argument("--__complete", dest="complete_kind",
                   help=argparse.SUPPRESS)
    p.add_argument("--__ctx-from", dest="ctx_from", help=argparse.SUPPRESS)
    p.add_argument("--__ctx-to", dest="ctx_to", help=argparse.SUPPRESS)
    p.add_argument("--__ctx-mic", dest="ctx_mic", help=argparse.SUPPRESS)
    p.add_argument("--__ctx-version", dest="ctx_version", help=argparse.SUPPRESS)
    p.add_argument("--__ctx-device", dest="ctx_device", help=argparse.SUPPRESS)
    return p


def resolve_date_range(args: argparse.Namespace,
                       default_dates: list[date]) -> None:
    """Mutate args to fill in from_date/to_date.

    `default_dates` are the capture dates used only to infer `from_date` when
    neither --from nor --days is given (earliest capture across all devices).
    """
    if args.days is not None:
        if args.from_date or args.to_date:
            raise SystemExit("--days is mutually exclusive with --from/--to")
        today = date.today()
        args.from_date = today - timedelta(days=args.days)
        args.to_date = today
        return
    if args.to_date is None:
        args.to_date = date.today()
    if args.from_date is None:
        if not default_dates:
            raise SystemExit(
                "no media found on connected volumes; specify --from explicitly"
            )
        args.from_date = min(default_dates)


def _range_default_dates(discovered: list[tuple['Device', list[Path], list]]) -> list[date]:
    """Capture dates across every device's pre-filter items, for range inference.

    Mic items are `Clip` (use .start); group devices are `MediaGroup`
    (use .timestamp)."""
    dates: list[date] = []
    for device, _relevant, items_all in discovered:
        for it in items_all:
            if device is DJI_MIC:
                dates.append(it.start.date())
            else:
                dates.append(it.timestamp.date())
    return dates


def confirm(prompt: str) -> bool:
    if not sys.stdin.isatty():
        return False  # never block in non-interactive contexts
    sys.stderr.write(prompt)
    sys.stderr.flush()
    try:
        ans = input().strip().lower()
    except EOFError:
        return False
    return ans in ("y", "yes")


def validate_runtime() -> None:
    if shutil.which("ffmpeg") is None:
        raise SystemExit("error: ffmpeg not found on PATH")


def validate_whisper(model: str) -> None:
    try:
        import_check = subprocess.run(
            [sys.executable, "-c", "import whisper"],
            capture_output=True, text=True, timeout=30,
        )
        if import_check.returncode != 0:
            raise SystemExit(
                f"error: cannot import whisper Python package "
                f"(--transcribe requested). stderr:\n{import_check.stderr}"
            )
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        raise SystemExit(f"error: whisper validation failed: {e}")
    pt = WHISPER_CACHE_DIR / f"{model}.pt"
    if not pt.exists():
        raise SystemExit(
            f"error: whisper model '{model}' not found at {pt}. "
            f"Available: "
            f"{', '.join(sorted(p.stem for p in WHISPER_CACHE_DIR.glob('*.pt')))}"
        )


def _confirm_dest(args: argparse.Namespace, items: list, chains: list) -> Path:
    """Single editable-prompt confirmation for the resolved dest path.

    With a slug positional, proposes <dest>/<earliest-shoot-date>-<slug>/.
    Without a slug, proposes --dest as-is. Either way the user can edit
    the proposed path before pressing enter. Empty + enter aborts.
    --yes skips the prompt and uses the proposal as-is.
    """
    if args.slug:
        earliest = _earliest_shoot_date(items, chains)
        if earliest is None:
            sys.exit("media-import: no usable shoot dates found; cannot resolve slug.")
        proposed = args.dest / f"{earliest.isoformat()}-{args.slug}"
    else:
        proposed = args.dest

    if args.yes:
        print(f"Dest: {proposed}", file=sys.stderr)
        return proposed

    chosen = prompt_with_default("Dest", str(proposed)).strip()
    if not chosen:
        sys.exit("aborted.")
    resolved = Path(chosen).expanduser()
    if not resolved.is_absolute():
        sys.exit(
            f"media-import: dest {chosen!r} is a relative path. "
            f"Enter an absolute path or press enter to accept the default."
        )
    return resolved


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.complete_kind:
        return cmd_complete(args.complete_kind, args)

    if args.verify_sony:
        return cmd_verify_sony()

    validate_runtime()
    if args.transcribe:
        status("Checking whisper install...")
        validate_whisper(args.model)

    if args.dest is None:
        parser.error("--dest is required")

    # Device selection — every detected device (auto) or the one requested.
    all_volumes = find_all_volumes()
    devices = select_devices(all_volumes, requested=args.device)

    # --transcribe is meaningful only if at least one selected device supports it.
    if args.transcribe and not any(d.supports_transcribe for d in devices):
        names = ", ".join(d.name for d in devices)
        sys.exit(
            f"media-import: --transcribe is not supported for {names}.\n"
            f"  (drone footage etc. — pass without --transcribe.)"
        )

    # Phase 1: per-device read-only discovery. Drop non-viable devices with a
    # note rather than aborting a ready device.
    discovered: list[tuple[Device, list[Path], list]] = []
    for device in devices:
        if device is SONY_A7C and not _sony_is_verified():
            sys.stderr.write(
                "media-import: skipping Sony A7C — not verified.\n"
                "  Run `media-import --verify-sony` first to enable it.\n"
            )
            continue
        relevant = [v for v in all_volumes if device.detect(v)]
        if not relevant:
            continue
        if device is SONY_A7C:
            require_exiftool()
        print(f"Found {device.name} on:", file=sys.stderr)
        for v in relevant:
            print(f"  {v}", file=sys.stderr)
        items_all = device.discover(relevant)
        if not items_all:
            sys.stderr.write(f"  (no {device.name} files matched; skipping)\n")
            continue
        discovered.append((device, relevant, items_all))

    if not discovered:
        clear_status()
        sys.stderr.write("error: no importable media on connected volumes.\n")
        return 2

    # Phase 2: one date range across all devices' pre-filter items.
    resolve_date_range(args, _range_default_dates(discovered))

    # Phase 3: filter + chain-detect per device. Drop devices that filter empty.
    prepped: list[PreparedImport] = []
    union_items: list = []
    union_chains: list = []
    for device, relevant, items_all in discovered:
        items = device.filter_by_args(items_all, args)
        if not items:
            continue
        chains = build_chains(items) if device is DJI_MIC else []
        prepped.append(PreparedImport(device, relevant, items, chains, Plan(), {}))
        union_items.extend(items)
        union_chains.extend(chains)

    if not prepped:
        clear_status()
        sys.stderr.write("no media matched the given filters.\n")
        return 0

    # Phase 4: one dest prompt across the union of all devices.
    args.dest = _confirm_dest(args, union_items, union_chains)

    # Phase 5: build plans + estimates per device against the shared dest.
    rates = load_rates()
    first_run = not RATE_CACHE_PATH.exists()
    for p in prepped:
        plan_input = p.chains if p.device is DJI_MIC else p.items
        p.plan = p.device.build_plan(plan_input, args)
        model = args.model if (args.transcribe and p.device.supports_transcribe) else None
        p.est = estimate_seconds(p.plan, rates, model, first_run)

    # Phase 6: one combined preview.
    clear_status()
    print(format_combined_preview(prepped, args))
    print()

    if args.dry_run:
        print("(dry run — nothing executed)")
        return 0

    # Combined free-space check (single dest, summed peaks).
    total_peak = sum(peak_required_bytes(p.plan)[0] for p in prepped)
    free = free_bytes_at(args.dest)
    if total_peak > free:
        sys.stderr.write(
            f"error: insufficient free space at {args.dest}: "
            f"need {fmt_size(total_peak)}, have {fmt_size(free)}, "
            f"short by {fmt_size(total_peak - free)}.\n"
        )
        return 4

    if not args.yes:
        if not confirm("Proceed? [y/N] "):
            print("aborted.")
            return 1

    # Phase 7: execute each device's plan in sequence. Idempotent staging means
    # a failure after an earlier device finished leaves that output intact and a
    # re-run skips it.
    overall_t0 = time.monotonic()
    total_joins = 0
    total_moves = 0
    total_skipped = 0
    total_overwritten = 0
    total_transcripts = 0
    trans_failures: list = []
    total_est = sum(p.est["total"] for p in prepped)
    try:
        for p in prepped:
            run_copies(p.plan, rates)
            run_joins(p.plan, rates)
            move_stats = run_singleton_moves(p.plan)
            run_audio_extracts(p.plan)
            trans_stats = run_transcribes(p.plan, args, rates)
            total_joins += len(p.plan.joins)
            total_moves += move_stats.get("count", 0)
            total_skipped += move_stats.get("skipped", 0)
            total_overwritten += move_stats.get("overwritten", 0)
            total_transcripts += trans_stats.get("count", 0)
            trans_failures.extend(trans_stats.get("failures", []))
    except KeyboardInterrupt:
        print("\ninterrupted; staging left intact for resume on next run.")
        return 130
    except RuntimeError as e:
        print(f"\nerror: {e}")
        return 3

    for p in prepped:
        cleanup_staging(p.plan)
    save_rates(rates)

    elapsed = time.monotonic() - overall_t0
    print()
    print(f"Done in {fmt_duration(elapsed)} (estimated {fmt_duration(total_est)}).")
    print(f"  Joined files: {total_joins}")
    overwrite_str = f", overwrote {total_overwritten}" if total_overwritten else ""
    print(f"  Singletons:   {total_moves} (skipped {total_skipped}{overwrite_str})")
    if total_transcripts:
        print(f"  Transcripts:  {total_transcripts}")
    if trans_failures:
        print(f"  Transcribe failures: {len(trans_failures)}")
        for path, err in trans_failures[:3]:
            print(f"    {path.name}: {err[:120]}")

    if args.eject:
        all_relevant = sorted({v for p in prepped for v in p.volumes})
        print()
        print("Ejecting source volumes:")
        try_eject_volumes(all_relevant)

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        clear_status()
        sys.stderr.write("interrupted.\n")
        sys.exit(130)
