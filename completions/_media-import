#compdef media-import

# media-import zsh completion
# Dynamic suggestions (dates, mics, versions, models) come from
# `media-import --__complete <kind>` which prints "value:description" lines for
# _describe. Data-driven flags (--from, --to, --mic, --version) progressively
# filter each other: each candidate set is computed from clips that pass every
# *other* currently-set flag.

_media-import() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '--device[Which device profile to use]:device:(auto dji sony)' \
    '--dest[Destination directory]:dest:_files -/' \
    '--from[Earliest recording date]:date: _media_import_complete dates-from' \
    '--to[Latest recording date]:date: _media_import_complete dates-to' \
    '--days[Last N days]:N:' \
    '--version[Which version to import]:version: _media_import_complete versions' \
    '--mic[Which transmitter]:mic: _media_import_complete mics' \
    '--join[Join auto-split chains (default)]' \
    '--no-join[Do not join auto-split chains]' \
    '--transcribe[Transcribe joined files]' \
    '--model[Whisper model]:model:_media_import_models' \
    '--yes[Skip confirmation prompt]' \
    '--dry-run[Preview only]' \
    '--verify-sony[Run Sony A7C real-card verification]' \
    '-h[Show help]' \
    '--help[Show help]' \
    '*::slug:'
}

# Return the value following the last occurrence of $1 in $words, or "".
# Handles both space-separated (--from VALUE) and equals (--from=VALUE) forms.
# Multiple occurrences → last wins. Tolerates partial / mid-edit values;
# callers must validate.
_media_import_arg_value() {
  local flag=$1
  local val="" i w
  for (( i = 1; i <= ${#words[@]}; i++ )); do
    w="${words[i]}"
    if [[ $w == "$flag" ]]; then
      val="${words[i+1]:-}"
    elif [[ $w == "$flag="* ]]; then
      val="${w#*=}"
    fi
  done
  printf '%s' "$val"
}

# Dispatcher for data-driven completions. Gathers values of the *other* set
# flags from $words, validates each, forwards only the valid ones to
# `media-import --__complete <kind>` via --__ctx-* flags.
_media_import_complete() {
  local kind=$1
  local from_val to_val mic_val ver_val device_val
  from_val=$(_media_import_arg_value --from)
  to_val=$(_media_import_arg_value --to)
  mic_val=$(_media_import_arg_value --mic)
  ver_val=$(_media_import_arg_value --version)
  device_val=$(_media_import_arg_value --device)

  # Don't pass the value of the flag currently being completed.
  case "$kind" in
    dates-from) from_val="" ;;
    dates-to)   to_val="" ;;
    mics)       mic_val="" ;;
    versions)   ver_val="" ;;
  esac

  local -a ctx_args
  if [[ -n "$from_val" && "$from_val" == [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] ]]; then
    ctx_args+=(--__ctx-from "$from_val")
  fi
  if [[ -n "$to_val" && "$to_val" == [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] ]]; then
    ctx_args+=(--__ctx-to "$to_val")
  fi
  case "$mic_val" in
    TX01|TX02|all) ctx_args+=(--__ctx-mic "$mic_val") ;;
  esac
  case "$ver_val" in
    edit|orig|both) ctx_args+=(--__ctx-version "$ver_val") ;;
  esac
  case "$device_val" in
    auto|dji|sony) ctx_args+=(--__ctx-device "$device_val") ;;
  esac

  local -a items
  local entry
  while IFS= read -r entry; do
    [[ -n "$entry" ]] && items+=("$entry")
  done < <(media-import --__complete "$kind" "${ctx_args[@]}" 2>/dev/null)

  (( ${#items[@]} > 0 )) || return 1

  case "$kind" in
    dates-from) _describe 'from date' items ;;
    dates-to)   _describe 'to date' items ;;
    mics)       _describe 'mic' items ;;
    versions)   _describe 'version' items ;;
  esac
}

_media_import_models() {
  local -a models
  local entry
  while IFS= read -r entry; do
    [[ -n "$entry" ]] && models+=("$entry")
  done < <(media-import --__complete models 2>/dev/null)
  if (( ${#models[@]} > 0 )); then
    _describe 'whisper model' models
  fi
}

_media-import "$@"
