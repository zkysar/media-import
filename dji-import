def cmd_complete(kind: str) -> int:
    """Hidden subcommand for zsh completion."""
    if kind == "dates":
        vols = find_dji_volumes()
        clips = discover_clips(vols)
        by_date: dict[date, dict[str, int]] = {}
        for c in clips:
            d = c.start.date()
            entry = by_date.setdefault(d, {"clips": 0, "audio_s": 0.0, "tx": set()})
            entry["clips"] += 1
            entry["audio_s"] += c.wav.duration_s
            entry["tx"].add(c.tx)
        for d in sorted(by_date):
            e = by_date[d]
            audio_m = int(e["audio_s"] / 60)
            tx_str = ",".join(sorted(e["tx"]))
            print(f"{d.isoformat()}:{e['clips']} clips · {audio_m}m · {tx_str}")
    elif kind == "models":
        if WHISPER_CACHE_DIR.exists():
            for p in sorted(WHISPER_CACHE_DIR.glob("*.pt")):
                print(p.stem)
    elif kind == "mics":
        for v in ("TX01", "TX02", "all"):
            print(v)
    elif kind == "versions":
        for v in ("edit", "orig", "both"):
            print(v)
    return 0


# ───────────────────────── argparse / main ─────────────────────────


def parse_iso_date(s: str) -> date:
    return datetime.strptime(s, "%Y-%m-%d").date()


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="dji-import",
        description="Import audio from DJI Mic 2 transmitters.",
    )
    p.add_argument("--dest", type=Path,
                   help="Destination directory (required for actual runs)")
    p.add_argument("--from", dest="from_date", type=parse_iso_date,
                   help="Earliest recording date (YYYY-MM-DD)")
    p.add_argument("--to", dest="to_date", type=parse_iso_date,
                   help="Latest recording date (YYYY-MM-DD)")
    p.add_argument("--days", type=int,
                   help="Last N days (mutually exclusive with --from/--to)")
    p.add_argument("--version", choices=("edit", "orig", "both"), default="both")
    p.add_argument("--mic", choices=("TX01", "TX02", "all"), default="all")
    p.add_argument("--join", dest="join", action="store_true", default=True)
    p.add_argument("--no-join", dest="join", action="store_false")
    p.add_argument("--transcribe", action="store_true",
                   help="Transcribe joined files via whisper")
    p.add_argument("--model", default="tiny",
                   help="Whisper model (only used with --transcribe)")
    p.add_argument("--yes", action="store_true",
                   help="Skip confirmation prompt")
    p.add_argument("--dry-run", action="store_true",
                   help="Show preview only; never execute")
    p.add_argument("--__complete", dest="complete_kind",
                   help=argparse.SUPPRESS)
    return p


def resolve_date_range(args: argparse.Namespace,
                        clips_for_default: list[Clip]) -> None:
    """Mutate args to fill in from_date/to_date."""
    if args.days is not None:
        if args.from_date or args.to_date:
            raise SystemExit("--days is mutually exclusive with --from/--to")
        today = date.today()
        args.from_date = today - timedelta(days=args.days)
        args.to_date = today
        return
    if args.to_date is None:
        args.to_date = date.today()
    if args.from_date is None:
        if not clips_for_default:
            raise SystemExit(
                "no clips found on connected mics; specify --from explicitly"
            )
        args.from_date = min(c.start.date() for c in clips_for_default)


def confirm(prompt: str) -> bool:
    if not sys.stdin.isatty():
        return False  # never block in non-interactive contexts
    sys.stderr.write(prompt)
    sys.stderr.flush()
    try:
        ans = input().strip().lower()
    except EOFError:
        return False
    return ans in ("y", "yes")


def validate_runtime() -> None:
    if shutil.which("ffmpeg") is None:
        raise SystemExit("error: ffmpeg not found on PATH")


def validate_whisper(model: str) -> None:
    try:
        import_check = subprocess.run(
            [sys.executable, "-c", "import whisper"],
            capture_output=True, text=True, timeout=30,
        )
        if import_check.returncode != 0:
            raise SystemExit(
                f"error: cannot import whisper Python package "
                f"(--transcribe requested). stderr:\n{import_check.stderr}"
            )
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        raise SystemExit(f"error: whisper validation failed: {e}")
    pt = WHISPER_CACHE_DIR / f"{model}.pt"
    if not pt.exists():
        raise SystemExit(
            f"error: whisper model '{model}' not found at {pt}. "
            f"Available: "
            f"{', '.join(sorted(p.stem for p in WHISPER_CACHE_DIR.glob('*.pt')))}"
        )


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.complete_kind:
        return cmd_complete(args.complete_kind)

    validate_runtime()
    if args.transcribe:
        status("Checking whisper install...")
        validate_whisper(args.model)

    if args.dest is None:
        parser.error("--dest is required")


    # Discovery
    status("Scanning /Volumes for DJI cards...")
    volumes = find_dji_volumes()
    if not volumes:
        clear_status()
        sys.stderr.write("error: no DJI cards found at /Volumes/*. "
                         "Plug in your transmitters and try again.\n")
        return 2

    vol_names = ", ".join(v.name for v in volumes)
    status(f"Indexing audio on {len(volumes)} card(s): {vol_names}...")
    clips_all = discover_clips(volumes)
    if not clips_all:
        clear_status()
        sys.stderr.write("error: connected volumes have no DJI files matching pattern.\n")
        return 2

    status(f"Found {len(clips_all)} clips · planning import...")
    resolve_date_range(args, clips_all)

    # Filter by date range, mic, version
    clips = filter_by_args(clips_all, args)
    if args.version == "both":
        # Keep both
        pass
    if not clips:
        clear_status()
        sys.stderr.write("no clips matched the given filters.\n")
        return 0

    # Build chains and plan
    chains = build_chains(clips)
    plan = build_plan(chains, args)

    # Estimate
    rates = load_rates()
    first_run = not RATE_CACHE_PATH.exists()
    est = estimate_seconds(plan, rates,
                            args.model if args.transcribe else None,
                            first_run)

    # Preview
    clear_status()
    print(format_preview(plan, chains, volumes, args, est))
    print()

    if args.dry_run:
        print("(dry run — nothing executed)")
        return 0

    if not args.yes:
        if not confirm("Proceed? [y/N] "):
            print("aborted.")
            return 1

    # Execute
    overall_t0 = time.monotonic()
    try:
        copy_stats = run_copies(plan, rates)
        join_stats = run_joins(plan, rates)
        move_stats = run_singleton_moves(plan)
        trans_stats = run_transcribes(plan, args, rates)
    except KeyboardInterrupt:
        print("\ninterrupted; staging left intact for resume on next run.")
        return 130
    except RuntimeError as e:
        print(f"\nerror: {e}")
        return 3

    cleanup_staging(plan)
    save_rates(rates)

    elapsed = time.monotonic() - overall_t0
    print()
    print(f"Done in {fmt_duration(elapsed)} (estimated {fmt_duration(est['total'])}).")
    print(f"  Joined files: {len(plan.joins)}")
    print(f"  Singletons:   {move_stats.get('count', 0)} "
          f"(skipped {move_stats.get('skipped', 0)})")
    if plan.transcribes:
        x_realtime = (trans_stats["audio_s"] / max(0.1, trans_stats["elapsed"] - 10.0)
                      if trans_stats["elapsed"] > 10 else 0.0)
        print(f"  Transcripts:  {trans_stats['count']} "
              f"({fmt_audio_duration(trans_stats['audio_s'])} audio · "
              f"{fmt_duration(trans_stats['elapsed'])} wall · "
              f"{x_realtime:.1f}× realtime)")
    if trans_stats.get("failures"):
        print(f"  Transcribe failures: {len(trans_stats['failures'])}")
        for path, err in trans_stats["failures"][:3]:
            print(f"    {path.name}: {err[:120]}")

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        clear_status()
        sys.stderr.write("interrupted.\n")
        sys.exit(130)
